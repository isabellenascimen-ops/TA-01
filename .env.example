# --- Banco de dados ---
POSTGRES_PASSWORD=trajectory_dev_pw
DATABASE_URL=postgresql+asyncpg://trajectory:trajectory_dev_pw@localhost:5432/trajectory_dev

# --- Provedor de LLM ---
# "local_stub" = determinístico, sem rede e sem custo (usado nos testes)
# "anthropic"  = provedor real; exige ANTHROPIC_API_KEY
LLM_PROVIDER=local_stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Provedor de embeddings (independente do LLM, ver app/memory/embeddings.py) ---
# "local_hash" = determinístico, sem rede; NÃO captura semântica real
# "voyage"     = provedor real; exige VOYAGE_API_KEY e o pacote 'voyageai'
EMBEDDING_PROVIDER=local_hash
EMBEDDING_DIM=256
VOYAGE_API_KEY=
