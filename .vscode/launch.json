{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 padrão: sobe o servidor com reload e permite breakpoints
      // dentro do pipeline de deliberação.
      "name": "API: uvicorn (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "jinja": false,
      "justMyCode": false
    },
    {
      // Depurar TODA a suíte.
      "name": "Testes: pytest (tudo)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      // Depurar apenas o arquivo de teste aberto no editor.
      "name": "Testes: pytest (arquivo atual)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "${file}"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ]
}
